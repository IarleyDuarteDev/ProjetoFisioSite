# Configuração do ambiente local Docker Compose. Para Supabase, veja backend/.env.example.
POSTGRES_PASSWORD=fisio-local-dev
JWT_SECRET=chave-exclusiva-de-desenvolvimento-troque-em-producao-2026
# Chave que protege os CPFs (cifra e hash). Gere com: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64'))"
# Não troque depois de ter usuários cadastrados e nunca publique.
CPF_KEY=substitua-por-uma-chave-aleatoria-de-pelo-menos-32-bytes
# E-mail do administrador. A conta é criada na inicialização; defina a senha em "Esqueci minha senha".
ADMIN_EMAIL=
# Documentação interativa da API (/swagger-ui.html). Deixe false fora do computador de desenvolvimento.
SWAGGER_ENABLED=true
# Login social. Deixe vazio para desligar. Google: Client ID do tipo "Aplicativo da Web" (Google Cloud Console). Apple: Services ID.
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=
